# STATIC-ONLY v1 — сайт полностью статический, WordPress убран
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/html; charset=utf-8 .html
  AddType application/xml; charset=utf-8 .xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# следы WordPress и старая главная — на главную
RewriteRule ^index1\.html$ / [R=301,L]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^xmlrpc\.php$ / [R=301,L]
RewriteRule ^wp-(admin|login|includes)(/.*)?$ / [R=301,L]
RewriteRule ^wp-content/uploads/(.*)$ /assets/uploads/$1 [R=301,L]

# карантин закрыт наглухо
RewriteRule ^_wp-trash - [F,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /index.html